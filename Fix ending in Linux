#!/bin/bash
# Fix line endings for all shell and SQL scripts
# Run this script on the Linux server to convert Windows line endings to Unix

echo "========================================="
echo "Fixing Line Endings"
echo "========================================="
echo ""

# Fix shell scripts
for file in *.sh; do
    if [ -f "$file" ]; then
        echo "Fixing line endings for: $file"
        sed -i 's/\r$//' "$file"
        chmod +x "$file"
    fi
done

# Fix SQL scripts
for file in *.sql; do
    if [ -f "$file" ]; then
        echo "Fixing line endings for: $file"
        sed -i 's/\r$//' "$file"
    fi
done

# Fix markdown files
for file in *.md; do
    if [ -f "$file" ]; then
        echo "Fixing line endings for: $file"
        sed -i 's/\r$//' "$file"
    fi
done

echo ""
echo "========================================="
echo "All files have been fixed!"
echo "========================================="
