#!/bin/bash
# Fix line endings for all shell scripts
# Run this script on the Linux server to convert Windows line endings to Unix

for file in *.sh; do
    if [ -f "$file" ]; then
        echo "Fixing line endings for: $file"
        sed -i 's/\r$//' "$file"
        chmod +x "$file"
    fi
done

echo "All shell scripts have been fixed!"
